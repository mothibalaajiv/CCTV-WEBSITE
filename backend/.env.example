# Flask Environment Configuration
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Security Keys (Generate strong random keys for production)
SECRET_KEY=generate-a-strong-random-secret-key
JWT_SECRET_KEY=generate-a-strong-random-jwt-key

# MongoDB Database URI (MongoDB Atlas cluster connection string)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.segr9.mongodb.net/vms_db?retryWrites=true&w=majority

# Cloud Telemetry and Media Server URL
CLOUD_SERVER_URL=http://104.251.214.177:8000/api/diagnostics

# Allowed CORS Origins (Comma-separated URLs or * for all)
# Example: https://cctv-vms.onrender.com,https://cctv-updater.onrender.com
CORS_ORIGINS=*

# Optional: Initial Admin Password Auto-Sync
# If provided, the backend will auto-sync the 'admin' user password in MongoDB
ADMIN_PASSWORD=your-secure-admin-password

